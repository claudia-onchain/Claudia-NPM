{
  "name": "claudia-sdk-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Developer packages for Claudia (https://useclaudia.xyz): SDK, media, social, CLI and MCP server.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/sdk",
    "packages/media",
    "packages/social",
    "packages/cli",
    "packages/mcp"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "npm run build -w @useclaudia/sdk && npm run build -w @useclaudia/media && npm run build -w @useclaudia/social && npm run build -w @useclaudia/cli && npm run build -w @useclaudia/mcp",
    "typecheck": "npm run typecheck --workspaces && tsc -p examples/tsconfig.json",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs",
    "pack:check": "npm pack --dry-run --workspaces",
    "e2e:passport": "node scripts/e2e-passport.mjs",
    "mock-rpc": "node scripts/mock-solana-rpc.mjs 5089",
    "dry-run:social": "npm run dry-run -w @useclaudia/social"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/claudia-onchain/Claudia-NPM.git"
  }
}
